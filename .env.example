# Salin file ini menjadi .env, lalu isi dengan nilai sebenarnya.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rei_work_management?schema=public"
JWT_SECRET="kunci-acak-minimal-32-karakter"
AUTH_SECRET="kunci-acak-minimal-32-karakter"

# Opsional — lihat README bagian Konfigurasi.
# CRON_SECRET="rahasia-untuk-cron-eksternal"
# SCHEDULER_DISABLED="1"
# REALTIME_BACKEND="postgres"

# Catatan akun admin aplikasi (tidak dibaca oleh aplikasi)
APP_ADMIN_NAME="Admin REI"
APP_ADMIN_EMAIL="admin@contoh.id"
APP_ADMIN_PASSWORD="ganti-dengan-password-kuat"
