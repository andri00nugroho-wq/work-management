# Salin file ini menjadi .env, lalu isi dengan nilai sebenarnya.

# Skala internal 10-50 pengguna: 5 koneksi per instance sudah memadai.
# PgBouncer baru diperlukan bila pengguna aktif bersamaan mendekati 1.000.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rei_work_management?schema=public&connection_limit=5&pool_timeout=10"
JWT_SECRET="kunci-acak-minimal-32-karakter"
AUTH_SECRET="kunci-acak-minimal-32-karakter"

# Backup harian (dipakai scripts/backup-database.mjs)
BACKUP_DIR=".local-data/backups"
BACKUP_RETENTION_DAYS="14"
# BACKUP_S3_URI="s3://bucket/rei-work-management"
# PG_DUMP="/usr/bin/pg_dump"

# Catatan akun admin aplikasi (tidak dibaca oleh aplikasi)
APP_ADMIN_NAME="Admin REI"
APP_ADMIN_EMAIL="admin@contoh.id"
APP_ADMIN_PASSWORD="ganti-dengan-password-kuat"
